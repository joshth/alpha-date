# Copy to .env.local. NEVER commit a real .env file — credentials live in env vars only.
# Everything is optional: with no variables set, the app runs fully offline
# (local PGlite database + mock AI + mock moderation).

# --- AI provider (term discovery) ------------------------------------------
# Mock mode (default) simulates a discovery model, including realistic
# mistakes, so the evaluation harness has something to measure. Set
# MOCK_LLM=false AND supply your OWN key to call a real model. Put a hard
# monthly spend cap on that key.
MOCK_LLM=true
MOCK_LLM_LATENCY_MS=300
# Fraction (0-1) of mock calls that fail (provider outage simulation).
MOCK_LLM_FAILURE_RATE=0
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Moderation endpoint (safety gate) -------------------------------------
# Mock (default) flags a fixed list of synthetic markers. With MOCK_LLM=false
# and OPENAI_API_KEY set, the free OpenAI moderation endpoint is used.
MOCK_MODERATION_LATENCY_MS=150
# Fraction (0-1) of mock moderation calls that fail — test fail-closed here.
MOCK_MODERATION_FAILURE_RATE=0

# --- Database --------------------------------------------------------------
# Unset = embedded PGlite stored in ./.data (auto-migrated and seeded with
# synthetic data on first use). Set to YOUR OWN hosted Postgres (e.g. a Neon
# free-tier project), then run `pnpm db:migrate`. Never a production database.
# DATABASE_URL=
