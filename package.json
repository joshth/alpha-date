{
  "name": "alpha-date",
  "version": "0.1.0",
  "private": true,
  "description": "Gen Alpha Decoder™ | Date — Lexicon Safety & Quality Pipeline (derived teaching scaffold)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "eval": "tsx --conditions=react-server scripts/eval.ts",
    "eval:validate": "tsx --conditions=react-server scripts/eval.ts --validate-only",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ai-sdk/openai": "1.3.24",
    "@electric-sql/pglite": "0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-toast": "1.2.4",
    "ai": "4.3.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.454.0",
    "next": "15.5.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "postcss": "^8.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
